{
    "name": "digitalocean-mobile",
    "version": "1.3.1",
    "description": "The mobile app for DigitalOcean",
    "author": {
        "name": "Ocean",
        "url": "https://github.com/get-ocean/ocean"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/get-ocean/ocean"
    },
    "homepage": "https://github.com/get-ocean/ocean",
    "keywords": [
        "digitalocean",
        "cloud",
        "vps",
        "droplets",
        "kubernetes",
        "spaces",
        "app-platform",
        "managed-databases",
        "load-balancer",
        "expo",
        "monorepo",
        "react-native",
        "typescript",
        "biome",
        "sentry",
        "zustand",
        "eas"
    ],
    "license": "MIT",
    "main": "index.js",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "lint": "expo lint",
        "deps": "expo install --check",
        "console": "hot-updater console",
        "deploy:ios": "hot-updater deploy --platform ios -t \"*\"",
        "deploy:android": "hot-updater deploy --platform android -t \"*\"",
        "build:android": "eas build --platform android --profile production --local",
        "prebuild:ios": "expo prebuild --platform ios --clean",
        "prebuild:android": "expo prebuild --platform android --clean",
        "eas-build-post-install": "allow-scripts run"
    },
